@@ -0,0 +1,44 @@
+/*
+ * SIFT-based matching for small-area press sensors.
+ *
+ * API modelled on SIGFM by Matthieu Charette, Natasha England-Elbro and
+ * Timur Mangliev (goodix-fp-linux-dev/libfprint, "sigfm" branch). The
+ * matching step here uses a rigid RANSAC fit instead of SIGFM's pairwise
+ * angle voting.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#pragma once
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct SigfmImgInfo SigfmImgInfo;
+
+/* Extract SIFT keypoints and descriptors from an 8-bit grey image. */
+SigfmImgInfo *sigfm_extract (const unsigned char *pix, int width, int height);
+
+void sigfm_free_info (SigfmImgInfo *info);
+
+SigfmImgInfo *sigfm_copy_info (const SigfmImgInfo *info);
+
+int sigfm_keypoints_count (const SigfmImgInfo *info);
+
+/* Number of keypoint matches consistent with one rotation + shift.
+ * Returns 0 for no match, < 0 on internal error. */
+int sigfm_match_score (const SigfmImgInfo *probe, const SigfmImgInfo *enrolled);
+
+/* Serialise to a newly malloc()ed buffer; free it with free(). */
+unsigned char *sigfm_serialize_binary (const SigfmImgInfo *info, int *outlen);
+
+/* Returns NULL if the data is malformed. */
+SigfmImgInfo *sigfm_deserialize_binary (const unsigned char *bytes, int len);
+
+#ifdef __cplusplus
+}
+#endif
