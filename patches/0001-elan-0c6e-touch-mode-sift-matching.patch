+ * @error: Return location for error
+ *
+ * Returns: Whether the prints match
+ */
+FpiMatchResult
+fpi_print_sigfm_match (FpPrint *template, FpPrint *print, gint threshold, GError **error)
+{
+  SigfmImgInfo *probe;
+  gint best = 0;
+  guint i;
+
+  if (template->type != FPI_PRINT_SIGFM || print->type != FPI_PRINT_SIGFM)
+    {
+      *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_NOT_SUPPORTED,
+                                         "It is only possible to match SIGFM type print data");
+      return FPI_MATCH_ERROR;
+    }
+
+  if (print->prints->len != 1)
+    {
+      *error = fpi_device_error_new_msg (FP_DEVICE_ERROR_GENERAL,
+                                         "New print contains more than one print!");
+      return FPI_MATCH_ERROR;
+    }
+
+  probe = g_ptr_array_index (print->prints, 0);
+  for (i = 0; i < template->prints->len; i++)
+    {
+      gint score = sigfm_match_score (probe, g_ptr_array_index (template->prints, i));
+
+      fp_dbg ("sigfm score %d/%d", score, threshold);
+      if (score > best)
+        best = score;
+      if (score >= threshold)
+        return FPI_MATCH_SUCCESS;
+    }
+
+  fp_dbg ("sigfm best score %d/%d", best, threshold);
+  return FPI_MATCH_FAIL;
+}
+
