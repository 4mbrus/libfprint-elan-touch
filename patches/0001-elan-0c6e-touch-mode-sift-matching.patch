diff --git a/libfprint/sigfm/sigfm.cpp b/libfprint/sigfm/sigfm.cpp
new file mode 100644
index 0000000..970cde4
--- /dev/null
+++ b/libfprint/sigfm/sigfm.cpp
@@ -0,0 +1,211 @@
+/*
+ * SIFT-based matching for small-area press sensors. See sigfm.h.
+ *
+ * This library is free software; you can redistribute it and/or
+ * modify it under the terms of the GNU Lesser General Public
+ * License as published by the Free Software Foundation; either
+ * version 2.1 of the License, or (at your option) any later version.
+ */
+
+#include "sigfm.h"
+
+#include <opencv2/calib3d.hpp>
+#include <opencv2/core.hpp>
+#include <opencv2/features2d.hpp>
+#include <opencv2/imgproc.hpp>
+
+#include <cmath>
+#include <cstdint>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+struct SigfmImgInfo
+{
+  std::vector<cv::KeyPoint> keypoints;
+  cv::Mat                   descriptors; /* CV_32F, one row per keypoint */
+};
+
+namespace {
+
+/* Tuned on ELAN 04f3:0c6e touch captures (150x52 px). */
+constexpr double kUpscale = 2.0;        /* SIFT works better on the upscaled image */
+constexpr double kRatio = 0.75;         /* Lowe ratio test */
+constexpr double kRansacPx = 6.0;       /* reprojection threshold, upscaled pixels */
+constexpr double kMinScale = 0.85;      /* a real finger is not resized between touches */
+constexpr double kMaxScale = 1.15;
+
+constexpr uint32_t kMagic = 0x314d4653; /* "SFM1" */
+
+template<typename T> void
+put (std::vector<unsigned char> &out, T v)
+{
+  const unsigned char *p = reinterpret_cast<const unsigned char *> (&v);
+  out.insert (out.end (), p, p + sizeof (T));
+}
+
+template<typename T> bool
+get (const unsigned char *&p, const unsigned char *end, T &v)
+{
+  if (end - p < (std::ptrdiff_t) sizeof (T))
+    return false;
+  std::memcpy (&v, p, sizeof (T));
+  p += sizeof (T);
+  return true;
+}
+
+} // namespace
+
+extern "C" SigfmImgInfo *
+sigfm_extract (const unsigned char *pix, int width, int height)
+{
+  try
+    {
+      cv::Mat img (height, width, CV_8UC1, const_cast<unsigned char *> (pix));
+      cv::Mat big;
+      cv::resize (img, big, cv::Size (), kUpscale, kUpscale, cv::INTER_CUBIC);
+
+      auto *info = new SigfmImgInfo;
+      cv::SIFT::create ()->detectAndCompute (big, cv::noArray (),
+                                             info->keypoints, info->descriptors);
+      if (info->descriptors.type () != CV_32F && !info->descriptors.empty ())
+        info->descriptors.convertTo (info->descriptors, CV_32F);
+      return info;
+    }
+  catch (...)
+    {
+      return nullptr;
+    }
+}
+
+extern "C" void
+sigfm_free_info (SigfmImgInfo *info)
+{
+  delete info;
+}
+
+extern "C" SigfmImgInfo *
+sigfm_copy_info (const SigfmImgInfo *info)
+{
+  auto *copy = new SigfmImgInfo;
+  copy->keypoints = info->keypoints;
+  copy->descriptors = info->descriptors.clone ();
+  return copy;
+}
+
+extern "C" int
+sigfm_keypoints_count (const SigfmImgInfo *info)
+{
+  return info ? (int) info->keypoints.size () : 0;
+}
+
+extern "C" int
+sigfm_match_score (const SigfmImgInfo *probe, const SigfmImgInfo *enrolled)
+{
+  try
+    {
+      if (!probe || !enrolled ||
+          probe->keypoints.size () < 3 || enrolled->keypoints.size () < 3)
+        return 0;
+
+      std::vector<std::vector<cv::DMatch>> knn;
+      cv::BFMatcher (cv::NORM_L2).knnMatch (probe->descriptors,
+                                           enrolled->descriptors, knn, 2);
+
+      std::vector<cv::Point2f> pa, pb;
+      for (const auto &m : knn)
+        {
+          if (m.size () == 2 && m[0].distance < kRatio * m[1].distance)
+            {
+              pa.push_back (probe->keypoints[m[0].queryIdx].pt);
+              pb.push_back (enrolled->keypoints[m[0].trainIdx].pt);
+            }
+        }
+      if (pa.size () < 3)
+        return 0;
+
+      std::vector<uchar> inliers;
+      cv::Mat M = cv::estimateAffinePartial2D (pa, pb, inliers, cv::RANSAC,
+                                               kRansacPx);
+      if (M.empty ())
+        return 0;
+
+      const double scale = std::hypot (M.at<double> (0, 0), M.at<double> (1, 0));
+      if (scale < kMinScale || scale > kMaxScale)
+        return 0;
+
+      return cv::countNonZero (inliers);
+    }
+  catch (...)
+    {
+      return -1;
+    }
+}
+
+extern "C" unsigned char *
+sigfm_serialize_binary (const SigfmImgInfo *info, int *outlen)
+{
+  std::vector<unsigned char> out;
+  const cv::Mat &d = info->descriptors;
+
+  put<uint32_t> (out, kMagic);
+  put<uint32_t> (out, (uint32_t) info->keypoints.size ());
+  for (const auto &k : info->keypoints)
+    {
+      put<float> (out, k.pt.x);
+      put<float> (out, k.pt.y);
+      put<float> (out, k.size);
+      put<float> (out, k.angle);
+      put<float> (out, k.response);
+      put<int32_t> (out, k.octave);
+    }
+  put<uint32_t> (out, (uint32_t) d.rows);
+  put<uint32_t> (out, (uint32_t) d.cols);
+  for (int r = 0; r < d.rows; r++)
+    {
+      const float *row = d.ptr<float> (r);
+      const unsigned char *p = reinterpret_cast<const unsigned char *> (row);
+      out.insert (out.end (), p, p + d.cols * sizeof (float));
+    }
+
+  auto *buf = static_cast<unsigned char *> (std::malloc (out.size ()));
+  std::memcpy (buf, out.data (), out.size ());
+  *outlen = (int) out.size ();
+  return buf;
+}
+
+extern "C" SigfmImgInfo *
+sigfm_deserialize_binary (const unsigned char *bytes, int len)
+{
+  const unsigned char *p = bytes, *end = bytes + len;
+  uint32_t magic, n, rows, cols;
+
+  if (!get (p, end, magic) || magic != kMagic || !get (p, end, n) || n > 100000)
+    return nullptr;
+
+  auto *info = new SigfmImgInfo;
+  info->keypoints.reserve (n);
+  for (uint32_t i = 0; i < n; i++)
+    {
+      float x, y, size, angle, response;
+      int32_t octave;
+      if (!get (p, end, x) || !get (p, end, y) || !get (p, end, size) ||
+          !get (p, end, angle) || !get (p, end, response) || !get (p, end, octave))
+        {
+          delete info;
+          return nullptr;
+        }
+      info->keypoints.emplace_back (cv::Point2f (x, y), size, angle, response, octave);
+    }
+
+  if (!get (p, end, rows) || !get (p, end, cols) || rows != n || cols > 1024 ||
+      (std::size_t) (end - p) != (std::size_t) rows * cols * sizeof (float))
+    {
+      delete info;
+      return nullptr;
+    }
+  info->descriptors.create ((int) rows, (int) cols, CV_32F);
+  if (rows > 0)
+    std::memcpy (info->descriptors.data, p, (std::size_t) rows * cols * sizeof (float));
+  return info;
+}
